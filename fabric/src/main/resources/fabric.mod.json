{
    "schemaVersion": 1,
    "breaks": {
        "memoryleakfix": "<=1.1.1",
        "emojiful": "*"
    },
    "depends": {
        "minecraft": "~${minecraft_version_fmj}",
        "fabric-api": "*",
        "java": ">=${java_version}",
        "fabricloader": ">=${fabric_loader_version}"
    },
    "icon": "assets/${mod_id}/icon.png",
    "description": "${description}",
    "version": "${version}",
    "license": "${license}",
    "environment": "*",
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "contact": {
        "sources": "https://gitlab.com/Kyarei/caxton",
        "issues": "https://gitlab.com/Kyarei/caxton/-/issues",
        "homepage": "https://gitlab.com/Kyarei/caxton"
    },
    "name": "${mod_name}",
    "conflicts": {"iris": "*"},
    "entrypoints": {
        "client": ["xyz.flirora.caxton.fabric.CaxtonModGlyphContainerFlavor"],
        "main": [],
        "mm:early_risers": ["xyz.flirora.caxton.fabric.CaxtonEarlyRiser"]
    },
    "id": "${mod_id}",
    "authors": ["${mod_author}"]
}
